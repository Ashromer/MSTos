<Window x:Class="PluginFamilias.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Generador de Familias — Metalperfil Tech"
        Height="660" Width="760" MinHeight="580" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="#1E1E1E">

    <Window.Resources>
        <!-- Estilos de Marca Premium Oscuro -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#333337"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Editorial -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" BorderBrush="#9E272C" BorderThickness="2,0,0,0" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" x:Name="imgLogo" Width="36" Height="36" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="METALPERFIL TECH" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="#9E272C"/>
                    <TextBlock Text="Generación Inteligente de Familias Paramétricas (.rfa) desde CAD" FontFamily="Segoe UI" FontSize="11" Foreground="#999999"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Configuración -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Plantilla (.rft)" Width="85" Style="{StaticResource FieldLabel}"/>
                <TextBox  Grid.Row="0" Grid.Column="1" x:Name="txtTemplatePath" Style="{StaticResource PathBox}"
                          Text="Seleccione plantilla .rft..."
                          ToolTip="Plantilla de familia de Revit. Por defecto: Metric Curtain Wall Panel.rft"/>
                <Button   Grid.Row="0" Grid.Column="2" x:Name="btnSelectTemplate" Content="Examinar…"
                          Style="{StaticResource SmallButton}" Click="btnSelectTemplate_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Carpeta salida" Width="85" Style="{StaticResource FieldLabel}"/>
                <TextBox  Grid.Row="2" Grid.Column="1" x:Name="txtOutputPath" Style="{StaticResource PathBox}"
                          Text="Seleccione carpeta de salida..."
                          ToolTip="Los .rfa se guardan en subcarpetas por familia"/>
                <Button   Grid.Row="2" Grid.Column="2" x:Name="btnSelectOutput" Content="Examinar…"
                          Style="{StaticResource SmallButton}" Click="btnSelectOutput_Click"/>
            </Grid>
        </Border>

        <!-- Contenedor Principal (Selector de perfiles + Visor Canvas 2D) -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- Lista de Perfiles -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <Button x:Name="btnLoad" Content="Cargar CAD (DXF / DWG)…"
                                Style="{StaticResource ActionButton}" Background="#444444"
                                Padding="14,6" DockPanel.Dock="Left" Click="btnLoad_Click"
                                ToolTip="Lee las polilíneas de la capa FIBRA NEUTRA y las etiquetas de TITULOS"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="txtCount" Text="0 / 0" VerticalAlignment="Center"
                                       Foreground="#888" FontSize="11" Margin="0,0,6,0"/>
                            <Button x:Name="btnSelectAll"  Content="Todos"   Style="{StaticResource SmallButton}" Click="btnSelectAll_Click"/>
                            <Button x:Name="btnSelectNone" Content="Ninguno" Style="{StaticResource SmallButton}" Click="btnSelectNone_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="lstProfiles" BorderThickness="0" Background="Transparent" Foreground="#E0E0E0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="lstProfiles_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#2D2D30"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Foreground="#E0E0E0"
                                          VerticalContentAlignment="Center" Click="ProfileCheck_Click"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Vista Previa Vectorial -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Vista Previa de Fibra" FontSize="11" FontWeight="SemiBold"
                               Foreground="#888888" Margin="2,0,0,6"/>

                    <Border Grid.Row="1" Background="#1E1E1E" BorderBrush="#333337" BorderThickness="1" CornerRadius="4">
                        <Canvas x:Name="canvasPreview" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" SizeChanged="canvasPreview_SizeChanged"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Progreso -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ProgressBar x:Name="pbProgress" Height="6" Minimum="0" Visibility="Collapsed"
                          Foreground="#9E272C" Background="#333337" BorderThickness="0"/>
            <TextBlock x:Name="txtStatus" FontSize="11" Foreground="#CCCCCC" Margin="2,4,0,0" Text=""/>
        </StackPanel>

        <!-- Registro -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Registro de Procesamiento" FontSize="11" FontWeight="SemiBold"
                           Foreground="#888" Margin="2,0,0,4"/>
                <ScrollViewer Height="80" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="txtLog" TextWrapping="Wrap" FontSize="10"
                               FontFamily="Consolas" Foreground="#CCCCCC"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Generar -->
        <Button Grid.Row="5" x:Name="btnGenerate" Content="GENERAR FAMILIAS RFA"
                Style="{StaticResource ActionButton}" Background="#9E272C"
                Height="40" FontSize="13" Margin="0,12,0,0" Click="btnGenerate_Click"/>
    </Grid>
</Window>
