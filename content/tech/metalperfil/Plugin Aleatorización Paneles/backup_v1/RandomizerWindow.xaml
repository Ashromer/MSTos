<Window x:Class="PluginAleatorizar.UI.RandomizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aleatorizar Paneles — Metalperfil"
        Height="660" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinHeight="500" MinWidth="420">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Familia -->
        <GroupBox Grid.Row="0" Header="1. Familia de panel" Margin="0,0,0,6" Padding="6,4">
            <DockPanel>
                <Button x:Name="btnLoadFamilies" Content="Cargar familias"
                        DockPanel.Dock="Right" Width="110" Height="26"
                        Click="btnLoadFamilies_Click"/>
                <ComboBox x:Name="cmbFamilies"
                          DisplayMemberPath="Name"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"
                          SelectionChanged="cmbFamilies_SelectionChanged"/>
            </DockPanel>
        </GroupBox>

        <!-- 2. Tipos y porcentajes -->
        <GroupBox Grid.Row="1" Header="2. Distribución de tipos" Margin="0,0,0,4" Padding="4,4">
            <DataGrid x:Name="dgTypes"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      RowHeaderWidth="0"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tipo"
                                        Binding="{Binding TypeName}"
                                        Width="*"
                                        IsReadOnly="True"/>
                    <DataGridTextColumn Header="Ancho (mm)"
                                        Binding="{Binding WidthDisplay}"
                                        Width="90"
                                        IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Padding" Value="0,0,8,0"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="%"
                                        Binding="{Binding Percentage, UpdateSourceTrigger=LostFocus, StringFormat=F1}"
                                        Width="70">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Total porcentaje -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,2,4,8">
            <TextBlock Text="Total: " VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBlock x:Name="txtTotal" Text="0 %" VerticalAlignment="Center" FontWeight="Bold" Width="55"/>
            <Button x:Name="btnDistributeEqual" Content="Distribuir igual"
                    Width="100" Height="22" Margin="8,0,0,0"
                    FontSize="10" Click="btnDistributeEqual_Click"/>
        </StackPanel>

        <!-- 3. Muros cortina -->
        <GroupBox Grid.Row="3" Header="3. Muros cortina" Margin="0,0,0,6" Padding="6,4">
            <DockPanel>
                <Button x:Name="btnSelectWalls" Content="Seleccionar en modelo"
                        DockPanel.Dock="Right" Width="150" Height="26"
                        Click="btnSelectWalls_Click"/>
                <TextBlock x:Name="txtWallCount"
                           Text="Ningún muro seleccionado"
                           VerticalAlignment="Center"
                           Foreground="#666"
                           Margin="0,0,8,0"/>
            </DockPanel>
        </GroupBox>

        <!-- 4. Opciones -->
        <GroupBox Grid.Row="4" Header="4. Opciones" Margin="0,0,0,6" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="chkFixedSeed"
                          Content="Semilla fija:"
                          VerticalAlignment="Center"
                          Margin="0,0,6,0"/>
                <TextBox x:Name="txtSeed"
                         Width="70" Text="42"
                         VerticalAlignment="Center"
                         IsEnabled="{Binding IsChecked, ElementName=chkFixedSeed}"/>
                <TextBlock Text="(misma semilla → mismo resultado para cada muro)"
                           VerticalAlignment="Center"
                           FontSize="10" Foreground="#888"
                           Margin="10,0,0,0"/>
            </StackPanel>
        </GroupBox>

        <!-- Log -->
        <ScrollViewer x:Name="svLog"
                      Grid.Row="5"
                      Margin="0,0,0,6"
                      Background="#F5F5F5"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="txtLog"
                       TextWrapping="Wrap"
                       FontFamily="Consolas"
                       FontSize="10"
                       Padding="4"/>
        </ScrollViewer>

        <!-- Botón ejecutar -->
        <Button x:Name="btnRandomize"
                Grid.Row="6"
                Content="ALEATORIZAR PANELES"
                Height="42"
                Background="#2E7D32"
                Foreground="White"
                FontWeight="Bold"
                FontSize="14"
                Click="btnRandomize_Click"/>
    </Grid>
</Window>
