<Window x:Class="PluginFachadaInteractiva.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fachada Interactiva — Metalperfil Tech" 
        Height="720" Width="920" MinHeight="620" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Topmost="True">
    
    <Window.Resources>
        <!-- Estilos de Marca Premium Oscuro -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#333337"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- Estilos de DataGrid Dark -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="#1E1E1E"/>
            <Setter Property="AlternatingRowBackground" Value="#252526"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#333337"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
        </Style>
        
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#333337"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3F3F46"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>
    
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Editorial -->
        <Border Grid.Row="0" Background="#252526" CornerRadius="6" BorderBrush="#9E272C" BorderThickness="2,0,0,0" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" x:Name="imgLogo" Width="36" Height="36" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="METALPERFIL TECH" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Foreground="#9E272C"/>
                    <TextBlock Text="Generación y aleatorización interactiva en tiempo real de fachadas" FontFamily="Segoe UI" FontSize="11" Foreground="#999999"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: Muros y Escaneo -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="MUROS DETECTADOS" Style="{StaticResource CardTitle}"/>
                    <Button DockPanel.Dock="Top" x:Name="btnScan" Content="ESCANEAR PROYECTO" 
                            Style="{StaticResource ActionButton}" Background="#9E272C" Height="34" Margin="0,4,0,4" 
                            Click="btnScan_Click" ToolTip="Escanea el proyecto buscando muros cortina con el parámetro 'MP_GenerarFachada'."/>
                    <TextBlock DockPanel.Dock="Top" x:Name="txtWallCount" Text="0 muros encontrados" Margin="2,2,2,6" Foreground="#888888" FontSize="11" FontStyle="Italic"/>
                    <ListBox x:Name="lstWalls" BorderThickness="0" Background="Transparent" Foreground="#E0E0E0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="{Binding Display}" FontWeight="SemiBold" FontSize="11" Foreground="#CCCCCC"/>
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#888888"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Panel Derecho: Configuración de Fachada -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="CONFIGURACIÓN DE FACHADA INTERACTIVA" Style="{StaticResource CardTitle}"/>
                    
                    <!-- Controles de Material Global -->
                    <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#333337" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,4,0,8">
                        <StackPanel>
                            <CheckBox x:Name="chkGlobalMaterial" Content="Usar Material Global para todos los paneles" FontWeight="Bold" Checked="chkGlobalMaterial_Changed" Unchecked="chkGlobalMaterial_Changed" Foreground="#E0E0E0"/>
                            <StackPanel Orientation="Horizontal" Margin="20,8,0,0" IsEnabled="{Binding IsChecked, ElementName=chkGlobalMaterial}">
                                <TextBlock Text="Material Global:" VerticalAlignment="Center" Foreground="#CCCCCC" Margin="0,0,10,0" FontSize="11"/>
                                <ComboBox x:Name="cmbGlobalMaterial" Width="250" DisplayMemberPath="Name" SelectionChanged="cmbGlobalMaterial_SelectionChanged" Background="#1A1A1A" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Parámetros de Generación -->
                    <Border DockPanel.Dock="Top" Background="#1E1E1E" BorderBrush="#333337" BorderThickness="1" Padding="12" CornerRadius="4" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <CheckBox Grid.Column="0" Content="Semilla fija:" IsChecked="{Binding IsFixedSeed}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E0E0E0"/>
                            <TextBox Grid.Column="1" Text="{Binding SeedText}" Width="50" Height="22" Margin="8,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center" IsEnabled="{Binding IsFixedSeed}"/>
                            
                            <TextBlock Grid.Column="3" Text="Solape de montaje (mm):" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC" ToolTip="Reduce el ancho útil de la celda de rejilla para forzar el solape."/>
                            <TextBox Grid.Column="4" Text="{Binding SolapeText}" Width="50" Height="22" Margin="8,0,0,0" VerticalContentAlignment="Center" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Botón Ejecutar -->
                    <Button DockPanel.Dock="Bottom" x:Name="btnApply" Content="APLICAR CAMBIOS (REAL-TIME)" 
                            Style="{StaticResource ActionButton}" Background="#9E272C" Height="38" Margin="0,8,0,0" 
                            Click="btnApply_Click" FontSize="13"/>

                    <!-- Rejilla de Tipos de Paneles -->
                    <DataGrid x:Name="dgTypes" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,0,0,0" BorderThickness="0" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Panel / Familia" Binding="{Binding DisplayName}" IsReadOnly="True" Width="2*"/>
                            <DataGridTemplateColumn Header="Peso (%)" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Height="22" BorderThickness="0" Background="#1A1A1A" Foreground="White" VerticalContentAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Material Específico" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Materials}" 
                                                  SelectedValue="{Binding MaterialId}" 
                                                  SelectedValuePath="Id" 
                                                  DisplayMemberPath="Name"
                                                  Height="22" Background="#1A1A1A" Foreground="White"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Consola de Estado e Informes -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="CONSOLA DE ESTADO Y REGISTRO" Style="{StaticResource CardTitle}"/>
                <ProgressBar x:Name="pbProgress" Height="6" DockPanel.Dock="Bottom" Margin="0,6,0,0" Minimum="0" Maximum="100" Foreground="#9E272C" Background="#333337" BorderThickness="0"/>
                <TextBlock x:Name="txtStatus" DockPanel.Dock="Bottom" Text="Listo" Margin="2,4,2,0" Foreground="#CCCCCC" FontSize="11"/>
                <TextBox x:Name="txtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#1A1A1A" Foreground="#E0E0E0" FontFamily="Consolas" FontSize="10" BorderThickness="0" Padding="6"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
