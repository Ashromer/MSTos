        }
      ],
      "Outputs": [
        {
          "Id": "8e6b7705284d4449a55c3697a1ec47d9",
          "Name": "var[]",
          "Description": "var[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Get all of the Geometry associated with this object\n\nElement.Geometry ( ): var[]"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Import ToDSType(bool) extension method\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n#Preparing input from dynamo to revit\r\n\r\ncurve = IN[0]\r\ncurva2 = IN[1]\r\npuntos = [curve[0].StartPoint]\r\nhilera2 = curve[0].Offset(2.5)\r\nhilera3 = hilera2.Offset(2.5)\r\n#ellipses = [e1]\r\nvx = Vector.ByCoordinates(1,2.8,0)\r\nvy = Vector.ByCoordinates(3,4,0)\r\n\r\n#Ellipse.ByOriginVectors(KRV.StartPoint,vx,vy)\r\n\r\n#Primero crear una elipse y que interseque con la Spline\r\n\r\ndef elsep(KRV):\r\n\t#rango = range(0,int(KRV.Length))\r\n\trango = [float(x)/2 for x in range(0, int(curve[0].Length)*2)]\r\n\tellipsesgroup = [Ellipse.ByOriginVectors(KRV.StartPoint,vx,vy)]\r\n\teanterior =Ellipse.ByOriginVectors(KRV.StartPoint,vx,vy)\r\n\tpp = eanterior.Intersect(KRV)\r\n\tfor p in rango: \r\n\t\tpoint = KRV.PointAtSegmentLength(p)\r\n\t\tif (pp[0].DistanceTo(Ellipse.ByOriginVectors(point,vx,vy)) <= 2) and (eanterior.DoesIntersect(Ellipse.ByOriginVectors(point,vx,vy)) == False) and (pp[0].DistanceTo(Ellipse.ByOriginVectors(point,vx,vy)) >= 1.5):\r\n\t\t\tnuevaelipse = Ellipse.ByOriginVectors(point,vx,vy)\r\n\t\t\tellipsesgroup.append(nuevaelipse)\r\n\t\t\teanterior = nuevaelipse\t\t\r\n\t\t\tpuntos.append(point)\r\n\t\t\tpp = eanterior.Intersect(KRV)\r\n\treturn ellipsesgroup\r\n\t\r\nv = Vector.ByCoordinates(0, 0, 1);\t\t\r\nprueba = elsep(curve[0])\r\n\r\nhilera1 = []\r\nfor elipse in prueba:\r\n\tsolid = elipse.ExtrudeAsSolid(v,4)\r\n\thilera1.append(solid)\r\nhilera2curve = curve[0].Offset(2.5)\r\nhilera2pts = []\r\nhilera2eli = []\r\nfor p in puntos:\r\n\thilera2pts.append(hilera2curve.ClosestPointTo(p))\r\n\thilera2eli.append((Ellipse.ByOriginVectors(hilera2curve.ClosestPointTo(p),vx,vy)).ExtrudeAsSolid(v,-4))\r\n\t\r\nhilera3curve = curve[0].Offset(5)\r\nhilera3pts = []\r\nhilera3eli = []\r\nfor p in hilera2pts:\r\n\thilera3pts.append(hilera3curve.ClosestPointTo(p))\r\n\thilera3eli.append(((Ellipse.ByOriginVectors(hilera3curve.ClosestPointTo(p),vx,vy)).ExtrudeAsSolid(v,-4)).Translate(v,-4))\r\n\t\r\nprueba3 = elsep(curva2[0])\r\nhilera4 = []\r\nfor eli in prueba3:\r\n\thilera4.append((eli.ExtrudeAsSolid(v,4)))\r\n#OUT = prueba, prueba2, prueba3\r\n#OUT = drange(0,10,0.15)\r\nOUT = prueba,hilera1, hilera2curve, puntos, hilera2pts, hilera2eli, hilera3eli, [vx.Length, vy.Length], hilera4",
      "VariableInputPorts": true,
      "Id": "f1db22c614e84702b4aac52212d56e40",
      "Inputs": [
        {
          "Id": "540a531f4b6b46a981765bd0eb2e630c",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "31f233b10e8042f7be575ff0cfa2bbea",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "ba95905a37bb4a64a84fe64a4dbd921b",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded IronPython script."
