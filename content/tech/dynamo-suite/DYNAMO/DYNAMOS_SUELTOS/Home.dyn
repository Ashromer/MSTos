      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport clr\r\nclr.AddReference(\"ProtoGeometry\")\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# Import ToDSType(bool) extension method\r\nclr.AddReference(\"RevitNodes\")\r\nimport Revit\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\n#Preparing input from dynamo to revit\r\na =UnwrapElement(IN[0])\r\ncurve = IN[3]\r\nB =IN[1]\r\nc =IN[2]\r\nellipses = []\r\npuntos = []\r\n\r\ndef drange(start, stop, step):\r\n\tr = start\r\n\twhile r < stop:\r\n\t\tyield r\r\n\t\tr+= step\r\n#Primero crear una elipse y que interseque con la Spline\r\nfor p in a:\r\n\tif curve[0].DoesIntersect(p):\r\n\t\te = Ellipse.ByOriginRadii(p,3,5)\r\n\t\tellipses.append(e)\r\n\t\tf = e.Intersect(curve[0])[0] \r\n\tif (Ellipse.ByOriginRadii(p,2,4).Intersect(curve[0])[0]).DistanceTo(f) < 10:\r\n\t\tg = \"hola\"\r\n\te = Ellipse.ByOriginRadii(p,2,4)\r\n\tx = drange(0, 10, 0.025)\r\nfor p in x:\r\n\tif curve[0].PointAtParameter(p) == f:\r\n\t\tpoints.append(curve[0].PointAtParameter(p))\r\n\t\t\r\nOUT = g",
      "VariableInputPorts": true,
      "Id": "f1db22c614e84702b4aac52212d56e40",
