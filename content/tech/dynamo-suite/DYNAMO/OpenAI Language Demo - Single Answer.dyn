  "Name": "OpenAI Language Demo - Single Answer",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [],
  "Outputs": [],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import json\r\nfrom System.Net import WebClient\r\n\r\n\r\nif IN[0]:\r\n\r\n    webClient = WebClient()\r\n    webClient.Headers.Add(\"Content-Type\", \"application/json\")\r\n    webClient.Headers.Add(\"Authorization\", \"Bearer \" + IN[1])\r\n    \r\n    parameters = json.dumps({\r\n        \"model\": IN[2],\r\n        \"max_tokens\": IN[3],\r\n        \"temperature\": IN[4],\r\n        \"prompt\": IN[5],\r\n        })\r\n        \r\n    url = \"https://api.openai.com/v1/completions\"\r\n        \r\n    # Send the request to the OpenAI server and obtain a response:\r\n    response = json.loads(webClient.UploadString(url, parameters))\r\n\r\n    # Extract the actual text from the web response\r\n    responseText = response[\"choices\"][0][\"text\"]\r\n    \r\n     # Remove the line breaks at the start of the text otherwise Dynamo many not display the text correctly\r\n    responseText = responseText[2:]\r\n    \r\n    OUT = responseText",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "ff85acb03fc344039b0f7b02184fc263",
