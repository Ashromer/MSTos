    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndato = IN[0]\r\ngrosor1 = IN[1]\r\ngrosor2 = IN[2]\r\ngrosor3 = IN[3]\r\ngrosor4 = IN[4]\r\n# Create a new list to store the modified values\r\nlista = []\r\n# Place your code below this line\r\nfor i in range(len(dato)):\r\n    row = dato[i]\r\n    new_row = []  # Create a new row to store modified values\r\n    for j in range(len(row)):\r\n        value = float(row[j])\r\n        if value < 0.7 and value > 0.5:\r\n            new_row.append(grosor1)\r\n        elif value < 1.05 and value > 0.7:\r\n            new_row.append(grosor2)\r\n        elif value < 1.6 and value > 1.05:\r\n            new_row.append(grosor3)\r\n        elif value > 1.6:\r\n            new_row.append(grosor4)\r\n        else:\r\n            new_row.append(value)\r\n    lista.append(new_row)\r\n\r\n# Assign your output to the OUT variable.\r\nOUT = lista\r\n",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "5621178308174f33913bbec6c7ca20ff",
      "Inputs": [
        {
          "Id": "6120efb2383a4b57822263b0c70712de",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4b6b0279ff414f64b11b179f6305aa47",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bffd57b57a2246c69d4895a1e697f2f1",
          "Name": "IN[2]",
          "Description": "Input #2",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b1fd3b29cab243e3a2a1415466622e42",
          "Name": "IN[3]",
          "Description": "Input #3",
          "UsingDefaultValue": false,
          "Level": 2,
