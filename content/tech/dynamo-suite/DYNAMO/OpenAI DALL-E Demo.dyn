  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "import json\r\nfrom System.Net import WebClient\r\nfrom System import Convert\r\nfrom System.IO import MemoryStream\r\nfrom System.Drawing import Bitmap\r\n\r\n\r\nif IN[0]:\r\n\r\n    webClient = WebClient()\r\n    webClient.Headers.Add(\"Content-Type\", \"application/json\")\r\n    webClient.Headers.Add(\"Authorization\", \"Bearer \" + IN[1])\r\n    \r\n    url = \"https://api.openai.com/v1/images/generations\";\r\n    \r\n    parameters = json.dumps({\r\n        \"model\": \"image-alpha-001\",\r\n        \"prompt\": IN[2],\r\n        \"size\": IN[3],\r\n        \"n\": IN[4],\r\n        \"response_format\": \"b64_json\"})\r\n\r\n    \r\n    response = json.loads(webClient.UploadString(url, parameters))\r\n   \r\n    #Extract the bitmap images from the web response:\r\n\r\n    bitmaps = []\r\n    \r\n    for i, imageData in enumerate(response[\"data\"]):\r\n        memoryStream = MemoryStream(Convert.FromBase64String(imageData[\"b64_json\"]));\r\n        bitmaps.append(Bitmap.FromStream(memoryStream))\r\n        memoryStream.Close();\r\n   \r\n    OUT = bitmaps\r\n\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "ff85acb03fc344039b0f7b02184fc263",
      "Inputs": [
